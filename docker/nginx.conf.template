# Danika origin nginx — listens inside danika-edge (host :8081 → container :80).
# Public :80 on this VPS is Pinara. Pinara matches danikahub.ir / school.danikahub.ir
# by Host and proxies to 127.0.0.1:8081. Do not bind host :80 from this stack.
#
# CDN (Arvan) terminates TLS; this origin is HTTP only. Default server MUST
# serve the site (not a HTTPS redirect) — CDN health checks and mismatched
# Host headers hit the first/default block; a 301 to https:// on an HTTP-only
# origin causes CDN 502.
#
# Restore the visitor IP from ArvanCloud's X-Forwarded-For.
# CIDRs from https://www.arvancloud.ir/en/ips.txt
set_real_ip_from 185.143.232.0/22;
set_real_ip_from 188.229.116.16/30;
set_real_ip_from 94.101.182.0/27;
set_real_ip_from 2.144.3.128/28;
set_real_ip_from 37.32.16.0/27;
set_real_ip_from 37.32.17.0/27;
set_real_ip_from 37.32.18.0/27;
set_real_ip_from 37.32.19.0/27;
set_real_ip_from 185.215.232.0/22;
set_real_ip_from 178.131.120.48/28;
set_real_ip_from 94.101.183.0/28;
set_real_ip_from 78.157.36.112/28;
set_real_ip_from 95.38.61.80/28;
set_real_ip_from 193.24.119.0/29;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Default + apex (first = default server on :8081 only — not Pinara :80)
server {
    listen 80 default_server;
    server_name __WEB_DOMAIN__ _;
    server_tokens off;
    client_max_body_size 32m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://website:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}

# www — stay on HTTP at the origin; CDN handles public HTTPS
server {
    listen 80;
    server_name www.__WEB_DOMAIN__;
    return 301 http://__WEB_DOMAIN__$request_uri;
}

server {
    listen 80;
    server_name __SCHOOL_DOMAIN__;
    server_tokens off;
    client_max_body_size 32m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://school:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    server_name __API_DOMAIN__;
    server_tokens off;
    client_max_body_size 32m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://api:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_read_timeout 60s;
    }
}
