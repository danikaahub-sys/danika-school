enum BaseRole {
  PRINCIPAL
  DEPUTY
  TEACHER
  FINANCE
  COUNSELOR
  STAFF
  GUARDIAN
  STUDENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

model Position {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  baseRole    BaseRole @map("base_role")
  permissions String[]
  isAll       Boolean  @default(false) @map("is_all")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  memberships  SchoolMembership[]
  invitations  Invitation[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("positions")
}

model SchoolMembership {
  id          String           @id @default(uuid())
  schoolId    String           @map("school_id")
  userId      String           @map("user_id")
  personId    String           @map("person_id")
  positionId  String           @map("position_id")
  status      MembershipStatus @default(INVITED)
  permVersion Int              @default(1) @map("perm_version")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Cascade)
  position Position @relation(fields: [positionId, schoolId], references: [id, schoolId])

  auditLogs AuditLog[]

  @@unique([schoolId, userId])
  @@unique([id, schoolId])
  @@index([schoolId, status])
  @@map("school_memberships")
}

model Invitation {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  tokenHash   String    @unique @map("token_hash")
  phone       String
  positionId  String    @map("position_id")
  personId    String    @map("person_id")
  invitedById String?   @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  position  Position @relation(fields: [positionId, schoolId], references: [id, schoolId])
  person    Person   @relation(fields: [personId, schoolId], references: [id, schoolId], onDelete: Cascade)
  invitedBy User?    @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([schoolId, phone])
  @@map("invitations")
}
