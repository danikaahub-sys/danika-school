enum MessageChannel {
  APP
  SMS
  BOTH
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Announcement {
  id        String         @id @default(uuid())
  schoolId  String         @map("school_id")
  title     String
  body      String
  channel   MessageChannel
  audience  Json
  sentAt    DateTime?      @map("sent_at")
  createdAt DateTime       @default(now()) @map("created_at")

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  deliveries MessageDelivery[]

  @@unique([id, schoolId])
  @@index([schoolId, sentAt])
  @@map("announcements")
}

model MessageTemplate {
  id        String         @id @default(uuid())
  schoolId  String         @map("school_id")
  title     String
  body      String
  channel   MessageChannel
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("message_templates")
}

model MessageDelivery {
  id             String         @id @default(uuid())
  schoolId       String         @map("school_id")
  announcementId String         @map("announcement_id")
  personId       String         @map("person_id")
  channel        MessageChannel
  status         DeliveryStatus @default(PENDING)
  error          String?
  sentAt         DateTime?      @map("sent_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId, schoolId], references: [id, schoolId], onDelete: Cascade)
  person       Person       @relation(fields: [personId, schoolId], references: [id, schoolId])

  @@index([schoolId, announcementId])
  @@index([schoolId, status])
  @@map("message_deliveries")
}
